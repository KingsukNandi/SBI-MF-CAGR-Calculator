# All variables are optional except the Basic Auth pair in production.
# Copy to .env.local for local overrides.

# How long before the AMFI snapshot is revalidated (ms). Revalidation uses a
# conditional GET, so an unchanged file costs a 0-byte 304. Default: 1 hour.
# NAV_REVALIDATE_MS=3600000

# Sent as User-Agent to AMFI so they can identify and contact this deployment.
# Put a real contact in here before deploying anywhere public.
# AMFI_USER_AGENT=MF-Returns-Calculator/2.0 (+https://your-repo; you@example.com)

# Requests per client per minute. Counted per serverless instance, so this is
# a speed bump rather than real protection. Default: 30.
# RATE_LIMIT_PER_MINUTE=30

# Basic Auth. REQUIRED in production: if unset, the deployment refuses all
# requests with 503 rather than exposing itself publicly.
# BASIC_AUTH_USER=yourname
# BASIC_AUTH_PASSWORD=a-long-random-string

# Optional AI helper. Without GROQ_API_KEY the chat reports itself as
# unconfigured and the rest of the app is unaffected. Key from console.groq.com
# GROQ_API_KEY=gsk_...
# Groq deprecates models without notice; override if the default is rejected.
# GROQ_MODEL=llama-3.3-70b-versatile
