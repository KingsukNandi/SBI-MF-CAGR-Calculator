# Port the backend listens on.
PORT=3000

# REQUIRED in production: without it the server serves the API but no frontend,
# so every page returns 404.
NODE_ENV=production

# Comma-separated origins allowed to call the API cross-origin. Leave empty in
# production if the frontend is served from this same server (the default).
# ALLOWED_ORIGINS=https://example.com,https://www.example.com

# How long before the AMFI snapshot is revalidated (ms). Revalidation uses a
# conditional GET, so an unchanged file costs a 0-byte 304. Default 1 hour.
# NAV_REVALIDATE_MS=3600000

# Sent as User-Agent to AMFI so they can identify and contact this deployment.
# Put a real contact in here before deploying anywhere public.
# AMFI_USER_AGENT=MF-Returns-Calculator/1.0 (+https://your-repo; you@example.com)
